# =============================================================================
# PRODUCTION মোড — VPS/Codespace-এ ডিপ্লয় করার জন্য।
# ব্যবহার: cp configs/production.env.example configs/production.env
#          তারপর নিচের সব ⚠️ লাইন নিজের আসল ভ্যালু দিয়ে ভরো
#          তারপর: bash setup/setup_all.sh production
#
# JWT_SECRET/FERNET_KEY খালি রাখলে setup_all.sh নিজে জেনারেট করে বসিয়ে দেবে।
# =============================================================================

# ⚠️ VPS/সার্ভারে নিজে Postgres হোস্ট না করে ফ্রি ম্যানেজড Postgres ব্যবহার করাই
# ভালো — সার্ভার রিস্টার্ট/রিডিপ্লয়ে ডেটা হারানোর ঝুঁকি থাকে না, ব্যাকআপ নিজে
# সামলাতে হয় না। সুপারিশ: **Neon** (neon.tech) — স্থায়ী ফ্রি টায়ার, কোনো কার্ড
# লাগে না, ৫১২MB স্টোরেজ। বিকল্প: Supabase (supabase.com, ৫০০MB, ১ সপ্তাহ
# নিষ্ক্রিয় থাকলে প্রজেক্ট পজড হয়, ড্যাশবোর্ড থেকে এক ক্লিকে আনপজ করা যায়)।
#
# Neon: প্রজেক্ট বানানোর পর "Connection string" এ **pooled** কানেকশন (হোস্টনেমে
# "-pooler" থাকবে) কপি করো, শেষে ?sslmode=require যোগ করো, আর নিচে
# DATABASE_USE_POOLER=true করো। উদাহরণ:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# Supabase: Project Settings → Database → Connection string → "Transaction"
# pooler (পোর্ট 6543) ব্যবহার করো, DATABASE_USE_POOLER=true করো। উদাহরণ:
#   DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hermes_multiuser
DATABASE_USE_POOLER=true

JWT_SECRET=
FERNET_KEY=

HERMES_BIN=hermes
HERMES_START_ARGS=gateway run --replace
HERMES_HOME_ROOT=/var/lib/hermes-multiuser/hermes-home
HERMES_SHARED_CONFIG_PATH=

PORT_RANGE_START=20000
PORT_RANGE_END=29000
IDLE_TIMEOUT_MINUTES=20

SHARED_OPENROUTER_KEY=এখানে_তোমার_OpenRouter_key_বসাও
SHARED_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SHARED_OPENROUTER_MODEL=openrouter/auto

# ⚠️ তোমার আসল ডোমেইন/IP বসাও (https সহ, রিভার্স প্রক্সির পেছনে থাকলে সেই URL):
GATEWAY_PUBLIC_URL=https://your-domain-or-ip.example.com
# ⚠️ * দিয়ে না রেখে আসল frontend origin(গুলো) বসানো নিরাপদ:
CORS_ORIGINS=https://your-domain-or-ip.example.com

# ---- UI-TARS গ্রাউন্ডিং (ঐচ্ছিক — ui_tars_grounding/README_BANGLA.md দ্রষ্টব্য) ----
# ⚠️ production-এ OpenRouter সুপারিশ করা হয় (নিজের GPU রাখার/আপটাইম দেখার ঝামেলা নেই):
UI_TARS_API_BASE=https://openrouter.ai/api/v1
UI_TARS_API_KEY=
UI_TARS_MODEL=bytedance/ui-tars-1.5-7b
